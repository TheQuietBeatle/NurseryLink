{
  "info": {
    "name": "NurseryLink Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health Check - GET /",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Body says Hello World!', function () {",
              "    pm.expect(pm.response.text()).to.eql('Hello World!');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Account - POST /account (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"jane.doe.{{$randomInt}}\",\n  \"full_name\": \"Jane Doe\",\n  \"email\": \"jane.doe+{{$randomInt}}@example.com\",\n  \"password\": \"Sup3rSecret!\",\n  \"role\": \"parent\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/account",
          "host": ["{{baseUrl}}"],
          "path": ["account"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Body confirms creation', function () {",
              "    pm.expect(pm.response.text()).to.eql('Account created successfully');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Account - POST /account (missing fields)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Missing Fields\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/account",
          "host": ["{{baseUrl}}"],
          "path": ["account"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 500 (DB rejects missing required columns)', function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test('Body reports an error', function () {",
              "    pm.expect(pm.response.text()).to.eql('Error creating account');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Account - GET /account/id/:id (existing)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/account/id/1",
          "host": ["{{baseUrl}}"],
          "path": ["account", "id", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array with one account', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array').with.lengthOf(1);",
              "});",
              "",
              "pm.test('Account has expected fields', function () {",
              "    const account = pm.response.json()[0];",
              "    pm.expect(account).to.have.property('id', '1');",
              "    pm.expect(account).to.have.property('username');",
              "    pm.expect(account).to.have.property('full_name');",
              "    pm.expect(account).to.have.property('email');",
              "    pm.expect(account).to.have.property('role');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Account - GET /account/id/:id (nonexistent)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/account/id/999999",
          "host": ["{{baseUrl}}"],
          "path": ["account", "id", "999999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an empty array', function () {",
              "    pm.expect(pm.response.json()).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Account - GET /account/id/:id (invalid id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/account/id/abc",
          "host": ["{{baseUrl}}"],
          "path": ["account", "id", "abc"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 500 (non-numeric id rejected by DB)', function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test('Error mentions invalid bigint input', function () {",
              "    pm.expect(pm.response.text()).to.include('invalid input syntax for type bigint');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Accounts - GET /account/role/:role (parent)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/account/role/parent",
          "host": ["{{baseUrl}}"],
          "path": ["account", "role", "parent"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is a non-empty array of parents', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array').that.is.not.empty;",
              "    body.forEach((account) => pm.expect(account.role).to.eql('parent'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Accounts - GET /account/role/:role (teacher)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/account/role/teacher",
          "host": ["{{baseUrl}}"],
          "path": ["account", "role", "teacher"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is a non-empty array of teachers', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array').that.is.not.empty;",
              "    body.forEach((account) => pm.expect(account.role).to.eql('teacher'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Accounts - GET /account/role/:role (nonexistent role)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/account/role/bogus",
          "host": ["{{baseUrl}}"],
          "path": ["account", "role", "bogus"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an empty array', function () {",
              "    pm.expect(pm.response.json()).to.eql([]);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
